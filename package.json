{
  "name": "fitment-calculator",
  "version": "1.0.0",
  "description": "Interactive wheel and tyre fitment calculator — static single-page app",
  "scripts": {
    "start": "node build.js && node server.js",
    "caddy": "caddy run --config Caddyfile --watch",
    "check": "node build.js && biome check --write .",
    "publish": "node build.js",
    "test": "node build.js && playwright install chromium && playwright test",
    "a11y": "node build.js && node server.js & playwright install chromium && node a11y.js",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.60.0",
    "terser": "^5.48.0",
    "wrangler": "^4.96.0"
  }
}
